{
  "manifest_version": 2,
  "version": "4.6.0",
  "name": "SnowLuma 反向适配器 / SnowLuma Reverse Adapter",
  "description": "QQ 反向 WebSocket 适配器：由 SnowLuma 主动连入 MaiBot（衍生自 MaiBot Team 的 SnowLuma 适配器） 支持多连接分流（slot 连接池），大消息不再阻塞其它动作。",
  "author": {
    "name": "PyreZ",
    "url": "https://github.com/pyre-z"
  },
  "license": "GPL-v3.0-or-later",
  "urls": {
    "repository": "https://github.com/pyre-z/MaiBot-SnowLuma-Reverse-Adapter",
    "homepage": "https://github.com/pyre-z/MaiBot-SnowLuma-Reverse-Adapter",
    "documentation": "https://github.com/pyre-z/MaiBot-SnowLuma-Reverse-Adapter",
    "issues": "https://github.com/pyre-z/MaiBot-SnowLuma-Reverse-Adapter/issues"
  },
  "plugin_type": "adapter",
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.jpg"
    }
  },
  "host_application": {
    "min_version": "1.2.0",
    "max_version": "999.999.999"
  },
  "sdk": {
    "min_version": "2.5.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "silk-python",
      "version_spec": ">=0.2.8"
    }
  ],
  "capabilities": [
    "chat.get_all_streams",
    "chat.open_session",
    "component.disable",
    "component.enable",
    "message.get_by_id"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN",
      "en-US"
    ]
  },
  "id": "pyre-z.snowluma-reverse-adapter"
}